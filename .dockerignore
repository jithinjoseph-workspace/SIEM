# Docker builds that use the repository root as context (the NDR images: one codebase with the
# SIEM) see only what they copy. Everything else, above all the build output, stays out.
*
!ndr/rust/ndr-engine
!wazuh-rust-angular/backend-rust/crates/provigil-common
!wazuh-rust-angular/backend-rust/crates/auth-service
**/target
# siem-api (wazuh-rust-angular/backend-rust/docker/siem-api.Dockerfile): the workspace and the
# files compiled into it; never data/ (agent packages, secrets) except the Sigma rules
!wazuh-rust-angular/backend-rust/Cargo.toml
!wazuh-rust-angular/backend-rust/Cargo.lock
!wazuh-rust-angular/backend-rust/crates
!wazuh-rust-angular/backend-rust/deploy
!wazuh-rust-angular/backend-rust/ruleset/sca
!wazuh-rust-angular/backend-rust/specs/sca-manifest
!wazuh-rust-angular/backend-rust/data/sigma
# the manager's default ruleset, the agentless scripts, and the agent package's files (its
# Windows programs are cross-built in the image; old copies and local builds stay out)
!wazuh-rust-angular/backend-rust/docker/siem-api-start.sh
!wazuh-rust-angular/backend-rust/ruleset/decoders
!wazuh-rust-angular/backend-rust/ruleset/rules
!wazuh-rust-angular/backend-rust/ruleset/lists
!wazuh-rust-angular/backend-rust/ruleset/mitre
!wazuh-rust-angular/backend-rust/etc/internal_options.conf
!wazuh-rust-angular/backend-rust/etc/local_decoder.xml
!wazuh-rust-angular/backend-rust/etc/local_rules.xml
!wazuh-rust-angular/backend-rust/data/manager/agentless
!wazuh-rust-angular/backend-rust/data/agent-dist/linux/provigil-agent-linux
!wazuh-rust-angular/backend-rust/data/agent-dist/linux/siem-agent-linux
!wazuh-rust-angular/backend-rust/data/agent-dist/windows
wazuh-rust-angular/backend-rust/data/agent-dist/windows/*.exe
wazuh-rust-angular/backend-rust/data/agent-dist/windows/*.exe.*
**/target
