# Copy to .env (git-ignored) and fill in. Read by start-all.bat (via backend-rust\service-env.bat)
# and by docker compose. Lines are KEY=VALUE, no quotes, no spaces around "=".
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
# Empty means no password. Changing it needs the ClickHouse container recreated:
#   docker compose up -d --force-recreate clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ndr
VALKEY_URL=redis://127.0.0.1:6379
# Shared by auth-service and siem-api. Left empty, service-env.bat generates one and writes it here.
JWT_SECRET=
