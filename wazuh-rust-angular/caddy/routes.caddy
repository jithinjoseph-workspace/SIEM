# The routes (imported by Caddyfile and by the Windows master's Caddyfile).
(xdr_routes) {
    # 1. High-Performance Compression
    encode zstd gzip

    # 2. Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # 3. Allow large telemetry log batches (up to 50MB)
    request_body {
        max_size 50MB
    }

    # 4. Auth Microservice APIs (/api/auth/*)
    handle /api/auth/* {
        reverse_proxy http://{$AUTH_UPSTREAM:auth-service:3001} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 4b. SIEM pages call the auth API under /api/v1/auth/* — same service
    handle /api/v1/auth/* {
        uri replace /api/v1/auth/ /api/auth/
        reverse_proxy http://{$AUTH_UPSTREAM:auth-service:3001} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 4c. Announcements also live in the auth microservice
    handle /api/announcements* {
        reverse_proxy http://{$AUTH_UPSTREAM:auth-service:3001} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 5. SIEM Microservice APIs (/api/v1/*, /api/siem/*, etc.)
    handle /api/* {
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 5b. NDR engine APIs (/api/ndr/x -> its /api/x; the more specific path wins over /api/*).
    # Present only when NDR is licensed and its engine runs.
    handle_path /api/ndr/* {
        rewrite * /api{path}
        reverse_proxy http://{$NDR_UPSTREAM:ndr-engine-1:3000} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 6. Real-Time WebSockets for Live Alerts Broadcast
    # SIEM WebSockets (/ws/siem/* and /ws/alerts)
    handle /ws/siem/* {
        rewrite * /ws/alerts
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088}
    }

    handle /ws/alerts {
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088}
    }

    # the console's SIEM live updates (/ws)
    handle /ws {
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088}
    }

    # NDR live telemetry (/ws/ndr -> the NDR engine's /ws)
    handle /ws/ndr* {
        uri replace /ws/ndr /ws 1
        reverse_proxy http://{$NDR_UPSTREAM:ndr-engine-1:3000}
    }

    # 7. Agent Binary Downloads (Windows .exe, Linux deb/rpm/sh)
    handle /downloads/* {
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088}
    }

    # site icons fetched through siem-api (the console's link previews)
    handle /favicon-proxy* {
        reverse_proxy http://{$SIEM_UPSTREAM:siem-api:8088}
    }

    # 8. Single Unified Angular SOC Frontend Dashboard (SPA)
    handle {
        root * {$CONSOLE_ROOT:/usr/share/caddy/html}
        file_server
        try_files {path} /index.html
    }
}
