#!/bin/sh
# ProVigil Linux Agent - Debian/Ubuntu postinst script
set -e

DIR="/opt/provigil-agent"
USER="provigil"
GROUP="provigil"
SHELL="/sbin/nologin"

if [ ! -f "${SHELL}" ]; then
    if [ -f "/bin/false" ]; then
        SHELL="/bin/false"
    fi
fi

case "$1" in
    configure)
        if ! getent group ${GROUP} > /dev/null 2>&1; then
            addgroup --system ${GROUP} > /dev/null 2>&1
        fi

        if ! getent passwd ${USER} > /dev/null 2>&1; then
            adduser --system --home ${DIR} --shell ${SHELL} --ingroup ${GROUP} ${USER} > /dev/null 2>&1
        fi

        mkdir -p "${DIR}/bin"
        mkdir -p "${DIR}/etc"
        mkdir -p "${DIR}/logs"
        mkdir -p "${DIR}/queue"
        mkdir -p "${DIR}/quarantine"
        mkdir -p "${DIR}/var/run"

        if [ ! -f "${DIR}/etc/agent-config.json" ]; then
            cat <<EOF > "${DIR}/etc/agent-config.json"
{
  "manager_url": "https://127.0.0.1:8443",
  "agent_name": "provigil-linux-endpoint",
  "buffer_capacity": 5000,
  "events_per_second": 500
}
EOF
            chmod 640 "${DIR}/etc/agent-config.json"
            chown root:${GROUP} "${DIR}/etc/agent-config.json"
        fi

        chown root:${GROUP} "${DIR}"
        chmod 750 "${DIR}"
        chown -R root:${GROUP} "${DIR}/bin"
        chmod 750 "${DIR}/bin"
        chmod 750 "${DIR}/bin/siem-agent-linux"
        chown -R ${USER}:${GROUP} "${DIR}/logs"
        chmod 750 "${DIR}/logs"
        chown -R ${USER}:${GROUP} "${DIR}/queue"
        chmod 750 "${DIR}/queue"
        chown -R root:${GROUP} "${DIR}/quarantine"
        chmod 700 "${DIR}/quarantine"

        ln -sf "${DIR}/bin/siem-agent-linux" /usr/local/bin/provigil-agentd
        ln -sf "${DIR}/bin/siem-agent-linux" /usr/local/bin/provigil-control

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload > /dev/null 2>&1 || true
            systemctl enable provigil-agent.service > /dev/null 2>&1 || true
            systemctl restart provigil-agent.service > /dev/null 2>&1 || true
        fi

        echo "[+] ProVigil Linux Agent successfully installed and configured."
    ;;
esac

exit 0
