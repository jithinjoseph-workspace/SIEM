# ==============================================================================
# Wazuh Next-Gen Endpoint Security Agent (Rust) - Systemd Service Unit
# ==============================================================================
[Unit]
Description=Wazuh Next-Gen Endpoint Security Agent (Rust)
Documentation=https://wazuh.com
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/ossec
ExecStart=/var/ossec/bin/siem-agent-linux --daemon
Restart=always
RestartSec=10
KillMode=process
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
