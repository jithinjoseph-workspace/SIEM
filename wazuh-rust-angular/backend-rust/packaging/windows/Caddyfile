# The Windows master's console (provigil-service runs Caddy as the ProVigilConsole service).
# Routes: routes.caddy, the same file the cloud and Docker setups use.
# Certificates come from Caddy's own CA, issued on demand for the name or address a browser
# uses (a LAN address cannot get a public certificate). Browsers warn until that CA is trusted:
# its root is in %ProgramData%\ProVigil\caddy\caddy\pki\authorities\local\root.crt.
{
    admin off
    # another web server on this PC (IIS) may hold 80/443: set HTTPS_PORT / HTTP_PORT in provigil.env
    http_port {$HTTP_PORT:80}
    https_port {$HTTPS_PORT:443}
    local_certs
    skip_install_trust
    on_demand_tls {
        # every name: the console is the only site here
        ask http://127.0.0.1:{$SIEM_PORT:8088}/api/health
    }
}

import routes.caddy

https:// {
    tls {
        on_demand
    }
    import xdr_routes
}

http:// {
    redir https://{host}{uri} permanent
}
