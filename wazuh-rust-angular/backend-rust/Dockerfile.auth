# Multi-stage Dockerfile for high-performance Rust Auth Microservice
FROM rust:1.80-slim-bookworm as builder

WORKDIR /usr/src/app

# Install build dependencies
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential g++ && rm -rf /var/lib/apt/lists/*

# Copy workspace source files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build optimized release binary
RUN cargo build --release -p auth-service

# Minimal runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl libstdc++6 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /usr/src/app/target/release/auth-service /app/auth-service

EXPOSE 8081

ENV RUST_LOG=info
ENV PORT=8081

CMD ["/app/auth-service"]
