# ==============================================================================
# Unified XDR Platform Caddy Configuration (NDR + SIEM + Single Angular UI)
# Supports: Automatic HTTPS (Let's Encrypt / ZeroSSL), Microservices Reverse Proxy,
# WebSockets, Compression (zstd/gzip), and Single Page Application (SPA) routing.
# ==============================================================================

{
    # Global options
    admin off
}

import routes.caddy

# Production: automatic TLS (Let's Encrypt / ZeroSSL) for SITE_DOMAIN, with HTTP->HTTPS redirects.
# With the default (localhost) Caddy serves https://localhost with its local CA.
{$SITE_DOMAIN:localhost} {
    import xdr_routes
}

# Development over plain HTTP, only for loopback names (never a public hostname).
http://localhost, http://127.0.0.1 {
    import xdr_routes
}
