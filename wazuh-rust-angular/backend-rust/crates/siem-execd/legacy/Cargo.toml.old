[package]
name = "siem-execd"
version = "0.1.0"
edition = "2021"
description = "Wazuh Active Response Execution Daemon (src/os_execd)"

[dependencies]
siem-core = { path = "../siem-core" }
siem-shared = { path = "../siem-shared" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
chrono = { version = "0.4", features = ["serde"] }
thiserror = "1.0"
tokio = { version = "1.40", features = ["full"] }
tracing = "0.1"
quick-xml = { version = "0.36", features = ["serialize"] }
flate2 = "1.0"

[dev-dependencies]
tempfile = "3"

[[bin]]
name = "wazuh-execd"
path = "src/bin/wazuh_execd.rs"
