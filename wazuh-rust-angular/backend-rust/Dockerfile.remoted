# Multi-stage Dockerfile for High-Capacity Wazuh Remoted Agent Gateway (50,000+ Agents)
FROM rust:1.80-slim-bookworm as builder

WORKDIR /usr/src/app

# Install build dependencies
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential g++ && rm -rf /var/lib/apt/lists/*

# Copy workspace source files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build optimized release binary for siem-remoted
RUN cargo build --release -p siem-remoted --bin siem-remoted

# Minimal runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /usr/src/app/target/release/siem-remoted /app/siem-remoted

# Port 1514 (UDP & TCP: Agent secure communications)
# Port 1515 (TCP: ossec-authd enrollment)
EXPOSE 1514/udp 1514/tcp 1515/tcp

ENV RUST_LOG=info
ENV REMOTED_PORT=1514
ENV AUTHD_PORT=1515
ENV CLIENT_KEYS_PATH=/var/ossec/etc/client.keys

VOLUME ["/var/ossec/etc"]

CMD ["/app/siem-remoted"]
