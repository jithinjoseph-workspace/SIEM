#!/bin/sh
# ProVigil Linux Agent - Debian/Ubuntu postrm script
set -e

case "$1" in
    purge)
        rm -rf /opt/provigil-agent/queue
        rm -rf /opt/provigil-agent/logs
        rm -rf /opt/provigil-agent/quarantine
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload > /dev/null 2>&1 || true
        fi
        if getent passwd provigil > /dev/null 2>&1; then
            deluser --system provigil > /dev/null 2>&1 || true
        fi
        if getent group provigil > /dev/null 2>&1; then
            delgroup --system provigil > /dev/null 2>&1 || true
        fi
    ;;
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload > /dev/null 2>&1 || true
        fi
    ;;
esac

exit 0
